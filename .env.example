# Public Supabase project coordinates; these are NOT privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact canonical HTTPS origin. Local development defaults to http://localhost:3000.
APP_URL=
# Optional server-only Auth administration. Member provisioning remains disabled
# until its identity verification policy and hosted setup have been approved.
# Never use a NEXT_PUBLIC name for this credential; never paste it into source.
SUPABASE_AUTH_ADMIN_KEY=
# Keep false until the separately approved activation migration, Auth redirects,
# confirmation delivery and hosted owner/member security checks pass.
MEMBER_PROVISIONING_ENABLED=false
# Native Supabase confirmation only after a member submits the request form.
# Automatic invitations and Resend remain disabled.
MEMBER_VERIFICATION_EMAIL_ENABLED=false
# Server-only. Keep sending disabled until the sending domain is verified.
RESEND_API_KEY=
RESEND_FROM=
RESEND_SENDING_ENABLED=false
# Project contact / reply-to. This Gmail address is not a Resend sender identity.
RESEND_REPLY_TO=
# Server-only flag. Enable only after Netlify form detection, consent/retention
# and hosted test submission have been reviewed. Unset/false for local preview.
CONTACT_FORM_ENABLED=false
