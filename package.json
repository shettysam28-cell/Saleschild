{
  "name": "saleschild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Saleschild \u2014 Knowledge Intelligence and Learning Management",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:check": "node scripts/security-check.mjs",
    "security:build": "node scripts/check-public-build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run security:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:hosted": "node scripts/test-hosted.mjs",
    "review:capture": "node scripts/capture-motion.mjs",
    "review:measure": "node scripts/measure-local.mjs",
    "security:repo": "node scripts/check-repository.mjs",
    "verify:repository": "node scripts/verify-repository.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "gsap": "3.15.0",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
